{
  "AppMode": "Backtest",
  "Data": {
    "Provider": "Yahoo",
    "CsvFolder": "./Data",
    "BenchmarkSymbol": "SPY",
    "UniverseFilePath": "universe.json",
    "Start": "2020-01-01",
    "End": "2024-12-31",
    "CacheFolder": ".quant_cache",
    "CacheMaxAgeDays": 1
  },
  "Indicators": {
    "HmaFast": 20,
    "HmaSlow": 50,
    "SupertrendAtrPeriod": 10,
    "SupertrendMultiplier": 3.0,
    "AdxPeriod": 14,
    "AdxThreshold": 20.0
  },
  "Strategy": {
    "TakeProfitAtrMultiple": 3.0,
    "StopLossAtrMultiple": 1.5,
    "TrailingStopAtrMultiple": 2.0,
    "MinimumAlphaScore": 40.0
  },
  "Risk": {
    "AccountRiskPerTradePct": 0.01,
    "MaxOpenPositions": 10,
    "MaxPortfolioHeat": 0.80,
    "RegimeHeatPenalty": 0.50
  },
  "Backtest": {
    "InitialCapital": 1000000.0,
    "CommissionPerShare": 0.005,
    "SlippageAtrFrac": 0.05,
    "ReportsFolder": "reports"
  },
  "Optimization": {
    "HmaFastRange":             [ 10, 15, 20 ],
    "HmaSlowRange":             [ 40, 50, 60 ],
    "AdxThresholdRange":        [ 18.0, 20.0, 25.0 ],
    "SupertrendMultiplierRange":[ 2.5, 3.0, 3.5 ],
    "Parallelism": -1,
    "TopN": 10,
    "EnableWalkForward": false,
    "InSampleFraction": 0.70
  },
  "Brokers": {
    "ActiveBroker": "Paper",
    "Zerodha": {
      "ApiKey": "",
      "ApiSecret": "",
      "AccessToken": "",
      "UserId": "",
      "Exchange": "NSE",
      "Product": "CNC"
    },
    "Upstox": {
      "ApiKey": "",
      "ApiSecret": "",
      "RedirectUri": "http://localhost:8080/upstox",
      "AccessToken": "",
      "Exchange": "NSE_EQ",
      "Product": "D"
    }
  },
  "LiveTrading": {
    "MaxDailyLossINR": 50000.0,
    "MaxOrderValueINR": 500000.0,
    "MinBarsWarmup": 60,
    "SquareOffMinutesBeforeClose": 15,
    "EnableAutoSquareOff": true,
    "PricePollingIntervalSeconds": 5,
    "OrderTimeoutSeconds": 60,
    "UseWebSocketFeed": true,
    "HistoricalBarsForSignals": 300,
    "YahooNseSuffix": ".NS"
  },
  "Database": {
    "Path": "quant_backtest.db"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}" } },
      { "Name": "File",
        "Args": { "path": "logs/quant_.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 } }
    ]
  }
}
