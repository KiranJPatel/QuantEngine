{
  "_comment": "Production overrides. Set DOTNET_ENVIRONMENT=Production or use env vars.",
  "_envvars": {
    "note": "All keys support env var override with QE_ prefix and __ separator.",
    "examples": [
      "QE_Brokers__Zerodha__AccessToken=<token>",
      "QE_Data__Start=2022-01-01",
      "QE_Backtest__InitialCapital=5000000"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "QuantEngine": "Information",
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Backtest": {
    "ReportsFolder": "/var/data/quant/reports"
  },
  "Data": {
    "CacheFolder": "/var/data/quant/.cache"
  },
  "Database": {
    "Path": "/var/data/quant/backtest.db"
  }
}
